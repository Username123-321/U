local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        o[k] = v
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(parent, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function stroke(parent, color, thickness)
    return new("UIStroke", {
        Color = color or COLORS.bg2,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, parent)
end

local function makeDraggable(frame, handle, onDrag)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            if onDrag then onDrag() end
        end
    end)
end

--// Единицы времени -> мс
local UNITS = {
    { name = "мс",  mult = 1 },
    { name = "сек", mult = 1000 },
    { name = "мин", mult = 60000 },
    { name = "час", mult = 3600000 },
    { name = "день",mult = 86400000 },
}

local function formatInterval(ms)
    if ms < 1000 then return string.format("%d мс", ms) end
    if ms < 60000 then return string.format("%.1f сек", ms/1000) end
    if ms < 3600000 then return string.format("%.1f мин", ms/60000) end
    return string.format("%.1f ч", ms/3600000)
end

