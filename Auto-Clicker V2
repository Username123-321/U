end

local function getNextOrder()
	local maxOrder = 0
	for _, p in ipairs(points) do
		if p.order > maxOrder then maxOrder = p.order end
	end
	return maxOrder + 1
end

local function createPointVisual(point)
	local circle = Instance.new("Frame")
	circle.Name = "Point_" .. point.id
	circle.Size = UDim2.new(0, 28, 0, 28)
	circle.Position = UDim2.new(0, point.position.X - 14, 0, point.position.Y - 14)
	circle.BackgroundColor3 = point.color
	circle.BorderSizePixel = 0
	circle.ZIndex = 10
	circle.Parent = screenGui

	local cCorner = Instance.new("UICorner")
	cCorner.CornerRadius = UDim.new(1, 0)
	cCorner.Parent = circle

	local cStroke = Instance.new("UIStroke")
	cStroke.Color = Color3.new(1, 1, 1)
	cStroke.Thickness = 2
	cStroke.Parent = circle

	local numLabel = Instance.new("TextLabel")
	numLabel.Size = UDim2.new(1, 0, 1, 0)
	numLabel.BackgroundTransparency = 1
	numLabel.Text = tostring(point.order)
	numLabel.TextColor3 = Color3.new(1, 1, 1)
	numLabel.TextSize = 12
	numLabel.Font = Enum.Font.GothamBold
	numLabel.ZIndex = 11
	numLabel.Parent = circle

	-- Перетаскивание точки
	local dragging = false
	local dragStart, startPos

	circle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = circle.Position
		end
	end)

	circle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			point.position = Vector2.new(circle.AbsolutePosition.X + 14, circle.AbsolutePosition.Y + 14)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			circle.Position = UDim2.new(0, startPos.X.Offset + delta.X, 0, startPos.Y.Offset + delta.Y)
		end
	end)

	point.visual = circle
	return circle
end
