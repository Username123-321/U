local rhCorner = Instance.new("UICorner")
rhCorner.CornerRadius = UDim.new(0, 4)
rhCorner.Parent = resizeHandle

local resizing = false
local resizeStart, startSize

resizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = true
		resizeStart = input.Position
		startSize = mainFrame.Size
	end
end)

resizeHandle.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - resizeStart
		local newX = math.clamp(startSize.X.Offset + delta.X, 280, 600)
		local newY = math.clamp(startSize.Y.Offset + delta.Y, 320, 700)
		mainFrame.Size = UDim2.new(0, newX, 0, newY)
	end
end)

