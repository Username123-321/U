createPortalBtn.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root then return end
    local pName = (portalNameInput.Text ~= "") and portalNameInput.Text or ("Портал " .. (#savedPortalsData + 1))
    
    -- Спавним физическую деталь портала в мире
    local portalPart = Instance.new("Part")
    portalPart.Name = "TeleportHubPortal_" .. pName
    portalPart.Size = Vector3.new(4, 6, 1)
    portalPart.CFrame = root.CFrame + (root.CFrame.LookVector * 4) + Vector3.new(0, 2, 0)
    portalPart.Anchored = true
    portalPart.CanCollide = false
    portalPart.Material = Enum.Material.Neon
    portalPart.Color = Color3.fromRGB(120, 60, 220)
    portalPart.Parent = Workspace
    
    local portalData = {
        Name = pName,
        Pos = {portalPart.Position.X, portalPart.Position.Y, portalPart.Position.Z},
        BgColor = Color3.fromRGB(28, 28, 36),
        TargetName = "",
        Part = portalPart
    }
    
    -- Обработка входа в портал (Touched)
    local debounce = false
    portalPart.Touched:Connect(function(hit)
        if debounce then return end
        local char = hit.Parent
        if char and char == player.Character then
            if portalData.TargetName and portalData.TargetName ~= "" then
                for _, targetP in ipairs(savedPortalsData) do
                    if targetP.Name == portalData.TargetName and targetP.Part and targetP.Part.Parent then
                        debounce = true
                        local r = getRoot()
                        if r then
                            r.CFrame = targetP.Part.CFrame + Vector3.new(0, 3, 0)
                        end
                        task.wait(1.5)
                        debounce = false
                        break
                    end
                end
            end
        end
    end)
    
    table.insert(savedPortalsData, portalData)
    
    for _, child in ipairs(portalsContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    for _, pt in ipairs(savedPortalsData) do
        createPortalUI(pt)
    end
end)

