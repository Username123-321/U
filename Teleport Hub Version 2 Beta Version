-- Вспомогательная функция конвертации цвета из HEX или кодов (например, G08L или стандартных)
local function parseColor(inputStr)
    inputStr = string.gsub(inputStr, "#", "")
    if #inputStr == 6 then
        local r = tonumber(string.sub(inputStr, 1, 2), 16) or 255
        local g = tonumber(string.sub(inputStr, 3, 4), 16) or 255
        local b = tonumber(string.sub(inputStr, 5, 6), 16) or 255
        return Color3.fromRGB(r, g, b)
    elseif inputStr:lower() == "red" or inputStr:lower() == "красный" then return Color3.fromRGB(220, 60, 60)
    elseif inputStr:lower() == "orange" or inputStr:lower() == "оранжевый" then return Color3.fromRGB(230, 130, 40)
    elseif inputStr:lower() == "green" or inputStr:lower() == "зеленый" then return Color3.fromRGB(60, 180, 80)
    elseif inputStr:lower() == "blue" or inputStr:lower() == "синий" then return Color3.fromRGB(50, 120, 220)
    elseif inputStr:lower() == "purple" or inputStr:lower() == "фиолетовый" then return Color3.fromRGB(150, 60, 200)
    elseif inputStr:lower() == "yellow" or inputStr:lower() == "желтый" then return Color3.fromRGB(240, 220, 50)
    end
    -- Если переданы условные буквенно-цифровые коды (по типу G08L)
    local hash = 0
    for i = 1, #inputStr do
        hash = (hash + string.byte(inputStr, i) * i) % 16777215
    end
    local r = math.floor(hash / 65536) % 256
    local g = math.floor(hash / 256) % 256
    local b = hash % 256
    return Color3.fromRGB(math.clamp(r, 40, 240), math.clamp(g, 40, 240), math.clamp(b, 40, 240))
end

