local function parseUserOffset(txt, prefix)
	local val = tonumber(string.gsub(txt or "", "[^%d%-]", ""))
	if val then val = math.clamp(math.round(val), -300, 300); return val, prefix .. ": " .. tostring(val) end
	return nil, nil
end
trackConn(mobOffsetXBox.FocusLost:Connect(function() local v, f = parseUserOffset(mobOffsetXBox.Text, "X"); if v then offsetX = v; mobOffsetXBox.Text = f else mobOffsetXBox.Text = "X: " .. tostring(offsetX) end end))
trackConn(mobOffsetYBox.FocusLost:Connect(function() local v, f = parseUserOffset(mobOffsetYBox.Text, "Y"); if v then offsetY = v; mobOffsetYBox.Text = f else mobOffsetYBox.Text = "Y: " .. tostring(offsetY) end end))

task.spawn(function()
	while not destroyed do
		if isRunning and #markers > 0 then
			if autoStopSec > 0 and (os.clock() - runStartedClock) >= autoStopSec then setRunningState(false); statusLabel.Text = "Авто-стоп по таймеру"
			elseif runMode == "TOGETHER" then
				for i = 1, #markers do
					if not isRunning or destroyed or runMode ~= "TOGETHER" then break end
					local item = markers[i]
					if item and item.enabled and executeMarkerClick(item, false) then
						local waitSec = turboMode and 0.005 or math.max(0.01, (item.customIntervalSec or defaultIntervalSec) + (jitterMs > 0 and (math.random(-jitterMs, jitterMs) / 1000) or 0))
						task.wait(waitSec)
					end
				end
				if isRunning and cycleGapMs > 0 then task.wait(cycleGapMs / 1000) else task.wait(0.005) end
			else
				local now, clickedAny = os.clock(), false
				for i = 1, #markers do
					if not isRunning or destroyed or runMode ~= "SEPARATE" then break end
					local item = markers[i]
					if item and item.enabled and (now - item.lastClickClock) >= (item.customIntervalSec or defaultIntervalSec) and executeMarkerClick(item, false) then clickedAny = true end
				end
				task.wait(clickedAny and 0.005 or 0.02)
			end
		else
			task.wait(0.05)
		end
	end
end)

