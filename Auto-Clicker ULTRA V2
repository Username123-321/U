	turboBtn.BackgroundColor3 = turboMode and Color3.fromRGB(210, 130, 35) or Color3.fromRGB(58, 65, 82)

	clearAllMarkers(); applyAllMarkerSizes(tonumber(cfg.size) or DEFAULT_MARKER_SIZE)
	if type(cfg.markers) == "table" then
		for _, item in ipairs(cfg.markers) do
			addMarker({ pos = UDim2.new(item.xs or 0.5, item.xo or 0, item.ys or 0.5, item.yo or 0), color = hexToColor3(item.c) or Color3.fromRGB(255, 195, 40), enabled = item.en ~= false, locked = item.lk == true, customIntervalSec = item.iv, pointLimit = tonumber(item.pl) or 0 })
		end
	end
	updateCounterTitle(); return true
end

