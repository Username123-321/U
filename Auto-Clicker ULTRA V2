local function rgbToHex(c)
	local r = math.clamp(math.round(c.R * 255), 0, 255)
	local g = math.clamp(math.round(c.G * 255), 0, 255)
	local b = math.clamp(math.round(c.B * 255), 0, 255)
	return string.format("#%02X%02X%02X", r, g, b)
end

local function hexToColor3(str)
	if not str then
		return nil
	end
	local clean = string.gsub(str, "[#%s]", "")
	if #clean == 3 then
		clean = string.sub(clean, 1, 1):rep(2)
			.. string.sub(clean, 2, 2):rep(2)
			.. string.sub(clean, 3, 3):rep(2)
	end
	if #clean ~= 6 or string.match(clean, "[^%x]") then
		return nil
	end
	return Color3.fromRGB(
		tonumber(string.sub(clean, 1, 2), 16),
		tonumber(string.sub(clean, 3, 4), 16),
		tonumber(string.sub(clean, 5, 6), 16)
	)
end

local function bindDragAndTap(handle, targetFrame, canDragFn, onTapFn)
	local dragging = false
	local moved = false
	local pointerInput = nil
	local startPos = nil
	local frameOrigin = nil

	trackConn(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			pointerInput = input
			startPos = input.Position
			frameOrigin = targetFrame.Position

			local stateConn
			stateConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					local wasCleanTap = dragging and (not moved)
					dragging = false
					pointerInput = nil
					if stateConn then
						stateConn:Disconnect()
					end
					if wasCleanTap and onTapFn then
						onTapFn()
					end
				end
			end)
		end
	end))

	trackConn(handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and not pointerInput then
				pointerInput = input
			end
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == pointerInput then
			if canDragFn and not canDragFn() then
				return
			end
			local delta = input.Position - startPos
			if delta.Magnitude > 6 then
				moved = true
			end
			if moved then
				targetFrame.Position = UDim2.new(
					frameOrigin.X.Scale,
					frameOrigin.X.Offset + delta.X,
					frameOrigin.Y.Scale,
					frameOrigin.Y.Offset + delta.Y
				)
			end
		end
	end))
end

local function bindCornerResize(cornerHandle, targetFrame, minW, minH, maxW, maxH)
	local resizing = false
	local resizeInput = nil
	local startMouse = nil
	local startSize = nil

	trackConn(cornerHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			resizeInput = input
			startMouse = input.Position
			startSize = targetFrame.AbsoluteSize

			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					resizeInput = nil
					if endConn then
						endConn:Disconnect()
					end
				end
			end)
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if resizing and input == resizeInput then
			local delta = input.Position - startMouse
			local newW = math.clamp(math.round(startSize.X + delta.X), minW, maxW)
			local newH = math.clamp(math.round(startSize.Y + delta.Y), minH, maxH)
			targetFrame.Size = UDim2.new(0, newW, 0, newH)
		end
	end))
end

local function cleanupAll()
	if destroyed then
		return
	end
	destroyed = true
	isRunning = false
	runToken += 1

	for _, conn in ipairs(connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(connections)

	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end

	if _G[GLOBAL_CLEANUP_KEY] == cleanupAll then
		_G[GLOBAL_CLEANUP_KEY] = nil
	end
end

