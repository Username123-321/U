local function updateWheelAt(pos2D)
	local absPos = wheelHolder.AbsolutePosition; local absSize = wheelHolder.AbsoluteSize
	local dx = pos2D.X - (absPos.X + absSize.X * 0.5); local dy = pos2D.Y - (absPos.Y + absSize.Y * 0.5)
	local dist = math.clamp(math.sqrt(dx * dx + dy * dy) / (absSize.X * 0.5), 0.08, 1)
	local angle = math.atan2(dy, dx); if angle < 0 then angle += math.pi * 2 end
	currentHue = angle / (math.pi * 2); currentSat = dist
	if selectedMarker then applyMarkerColor(selectedMarker, Color3.fromHSV(currentHue, currentSat, currentVal)) end
end

