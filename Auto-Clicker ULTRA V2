trackConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if waitingHotkeySlot then
		if waitingHotkeySlot == "TOGGLE" then toggleHotkey = input.KeyCode elseif waitingHotkeySlot == "ADD" then addMarkerHotkey = input.KeyCode elseif waitingHotkeySlot == "HIDE" then hideGuiHotkey = input.KeyCode end
		waitingHotkeySlot = nil; refreshHotkeyLabels(); statusLabel.Text = "Клавиша: " .. input.KeyCode.Name; return
	end
	if input.KeyCode == toggleHotkey then setRunningState(not isRunning) elseif input.KeyCode == addMarkerHotkey then addMarker() elseif input.KeyCode == hideGuiHotkey then setMinimizedState(not isMinimized) end
end))

