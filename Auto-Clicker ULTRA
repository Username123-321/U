local function buildConfigData()
	local list = {}
	for _, m in ipairs(markers) do
		local p = m.frame.Position
		table.insert(list, {
			xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset,
			c = rgbToHex(m.color), en = m.enabled, lk = m.locked,
			iv = m.customIntervalSec, pl = m.pointLimit or 0
		})
	end
	return {
		theme = currentThemeKey, runMode = runMode,
		intervalMs = math.round(defaultIntervalSec * 1000), holdMs = math.round(holdSec * 1000),
		delaySec = startDelaySec, limit = clickLimit, jitterMs = jitterMs, jitterPx = jitterPx,
		ox = userOffsetX, oy = userOffsetY, size = markerSize, inset = useTopInsetFix, autoMin = autoMinimizeOnStart,
		hkToggle = toggleHotkey.Name, hkAdd = addMarkerHotkey.Name, hkHide = hideGuiHotkey.Name, markers = list
	}
end

local function loadConfigData(cfg)
	if type(cfg) ~= "table" then return false end
	if cfg.theme and THEMES[cfg.theme] then applyTheme(cfg.theme) end
	runMode = (cfg.runMode == "SEPARATE") and "SEPARATE" or "TOGETHER"
	defaultIntervalSec = math.clamp(tonumber(cfg.intervalMs) or 100, 15, 60000) / 1000
	holdSec = math.clamp(tonumber(cfg.holdMs) or 15, 5, 2000) / 1000
	startDelaySec = math.clamp(tonumber(cfg.delaySec) or 0, 0, 120)
	clickLimit = math.clamp(math.round(tonumber(cfg.limit) or 0), 0, 1000000)
	jitterMs = math.clamp(math.round(tonumber(cfg.jitterMs) or 0), 0, 5000)
	jitterPx = math.clamp(math.round(tonumber(cfg.jitterPx) or 0), 0, 100)
	userOffsetX = math.clamp(math.round(tonumber(cfg.ox) or 0), -300, 300)
	userOffsetY = math.clamp(math.round(tonumber(cfg.oy) or 0), -300, 300)
	useTopInsetFix = cfg.inset == true; autoMinimizeOnStart = cfg.autoMin == true
	if cfg.hkToggle and Enum.KeyCode[cfg.hkToggle] then toggleHotkey = Enum.KeyCode[cfg.hkToggle] end
	if cfg.hkAdd and Enum.KeyCode[cfg.hkAdd] then addMarkerHotkey = Enum.KeyCode[cfg.hkAdd] end
	if cfg.hkHide and Enum.KeyCode[cfg.hkHide] then hideGuiHotkey = Enum.KeyCode[cfg.hkHide] end

	intervalBox.Text = tostring(math.round(defaultIntervalSec * 1000)); holdBox.Text = tostring(math.round(holdSec * 1000))
	limitBox.Text = tostring(clickLimit); delayBox.Text = tostring(startDelaySec)
	jitterMsBox.Text = tostring(jitterMs); jitterPxBox.Text = tostring(jitterPx)
	mobOffsetXBox.Text = "X: " .. tostring(userOffsetX); mobOffsetYBox.Text = "Y: " .. tostring(userOffsetY)
	insetBtn.Text = useTopInsetFix and "Inset: ВКЛ" or "Inset: ВЫКЛ"
	autoMinBtn.Text = autoMinimizeOnStart and "Сворот: ДА" or "Сворот: НЕТ"

	clearAllMarkers(); applyAllMarkerSizes(tonumber(cfg.size) or DEFAULT_MARKER_SIZE)
	if type(cfg.markers) == "table" then
		for _, item in ipairs(cfg.markers) do
			addMarker({
				pos = UDim2.new(item.xs or 0.5, item.xo or 0, item.ys or 0.5, item.yo or 0),
				color = hexToColor3(item.c) or Color3.fromRGB(255, 195, 40),
				enabled = item.en ~= false, locked = item.lk == true,
				customIntervalSec = item.iv, pointLimit = tonumber(item.pl) or 0
			})
		end
	end
	updateCounterTitle(); return true
end

