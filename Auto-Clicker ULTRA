local waitingHotkeySlot = nil

local function refreshMarkerVisualState(markerObj)
	if not markerObj or not markerObj.frame or not markerObj.frame.Parent then return end
	if markerObj.enabled then
		markerObj.frame.BackgroundColor3 = markerObj.color; markerObj.frame.BackgroundTransparency = 0.2
		markerObj.label.TextColor3 = Color3.fromRGB(15, 15, 15)
	else
		markerObj.frame.BackgroundColor3 = Color3.fromRGB(90, 95, 108); markerObj.frame.BackgroundTransparency = 0.55
		markerObj.label.TextColor3 = Color3.fromRGB(220, 220, 220)
	end
end

local function openMarkerSettings(markerObj)
	selectedMarker = markerObj
	refreshMarkerSelectionVisuals()
	markerPanel.Visible = true
	mpTitle.Text = "Точка #" .. tostring(markerObj.index) .. " (" .. tostring(markerObj.pointClicks or 0) .. ")"
	togglePointBtn.Text = markerObj.enabled and "Точка: ВКЛ" or "Точка: ВЫКЛ"
	togglePointBtn.BackgroundColor3 = markerObj.enabled and Color3.fromRGB(42, 152, 86) or Color3.fromRGB(150, 55, 65)
	lockPointBtn.Text = markerObj.locked and "Замок" or "Разблок"
	lockPointBtn.BackgroundColor3 = markerObj.locked and Color3.fromRGB(175, 120, 35) or Color3.fromRGB(58, 65, 82)
	local ms = markerObj.customIntervalSec and math.round(markerObj.customIntervalSec * 1000) or math.round(defaultIntervalSec * 1000)
	pointIntBox.Text = tostring(ms)
	pointLimitBox.Text = tostring(markerObj.pointLimit or 0)
	syncColorPanelFromColor(markerObj.color)
end

local pickingWheel = false
local function updateWheelAt(pos2D)
	local absPos = wheelHolder.AbsolutePosition; local absSize = wheelHolder.AbsoluteSize
	local dx = pos2D.X - (absPos.X + absSize.X * 0.5); local dy = pos2D.Y - (absPos.Y + absSize.Y * 0.5)
	local dist = math.clamp(math.sqrt(dx * dx + dy * dy) / (absSize.X * 0.5), 0.08, 1)
	local angle = math.atan2(dy, dx); if angle < 0 then angle += math.pi * 2 end
	currentHue = angle / (math.pi * 2); currentSat = dist
	if selectedMarker then applyMarkerColor(selectedMarker, Color3.fromHSV(currentHue, currentSat, currentVal)) end
end

trackConn(wheelHolder.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then pickingWheel = true; updateWheelAt(input.Position) end
end))
trackConn(UserInputService.InputChanged:Connect(function(input)
	if pickingWheel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateWheelAt(input.Position) end
end))
trackConn(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then pickingWheel = false end
end))
trackConn(valBar.MouseButton1Click:Connect(function()
	currentVal -= 0.2; if currentVal < 0.25 then currentVal = 1.0 end
	if selectedMarker then applyMarkerColor(selectedMarker, Color3.fromHSV(currentHue, currentSat, currentVal)) end
end))

local function applyRGBInputs()
	if syncingColorUI or not selectedMarker then return end
	local r = tonumber(string.match(rBox.Text or "", "%-?%d+")); local g = tonumber(string.match(gBox.Text or "", "%-?%d+")); local b = tonumber(string.match(bBox.Text or "", "%-?%d+"))
	if r and g and b then applyMarkerColor(selectedMarker, Color3.fromRGB(math.clamp(math.round(r), 0, 255), math.clamp(math.round(g), 0, 255), math.clamp(math.round(b), 0, 255)))
	else syncColorPanelFromColor(selectedMarker.color) end
end
trackConn(rBox.FocusLost:Connect(applyRGBInputs)); trackConn(gBox.FocusLost:Connect(applyRGBInputs)); trackConn(bBox.FocusLost:Connect(applyRGBInputs))
trackConn(hexBox.FocusLost:Connect(function()
	if syncingColorUI or not selectedMarker then return end
	local parsed = hexToColor3(hexBox.Text); if parsed then applyMarkerColor(selectedMarker, parsed) else hexBox.Text = rgbToHex(selectedMarker.color) end
end))
trackConn(togglePointBtn.MouseButton1Click:Connect(function()
	if not selectedMarker then return end
	selectedMarker.enabled = not selectedMarker.enabled; refreshMarkerVisualState(selectedMarker); openMarkerSettings(selectedMarker)
end))
trackConn(lockPointBtn.MouseButton1Click:Connect(function()
	if not selectedMarker then return end
	selectedMarker.locked = not selectedMarker.locked; openMarkerSettings(selectedMarker)
end))
trackConn(pointIntBox.FocusLost:Connect(function()
	if not selectedMarker then return end
	local num = tonumber(pointIntBox.Text)
	if num then selectedMarker.customIntervalSec = math.clamp(num, 15, 60000) / 1000; pointIntBox.Text = tostring(math.round(selectedMarker.customIntervalSec * 1000))
	else pointIntBox.Text = tostring(selectedMarker.customIntervalSec and math.round(selectedMarker.customIntervalSec * 1000) or math.round(defaultIntervalSec * 1000)) end
end))
trackConn(pointLimitBox.FocusLost:Connect(function()
	if not selectedMarker then return end
	local num = tonumber(pointLimitBox.Text)
	if num then selectedMarker.pointLimit = math.clamp(math.round(num), 0, 1000000) end
	pointLimitBox.Text = tostring(selectedMarker.pointLimit or 0)
end))
trackConn(mpCloseBtn.MouseButton1Click:Connect(function()
	markerPanel.Visible = false; selectedMarker = nil; refreshMarkerSelectionVisuals()
end))

