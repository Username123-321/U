	for i, item in ipairs(markers) do
		item.index = i
		if item.label then item.label.Text = tostring(i) end
		if selectedMarker == item and markerPanel.Visible then mpTitle.Text = "Точка #" .. tostring(i) .. " (" .. tostring(item.pointClicks or 0) .. ")" end
	end
end

local function applyAllMarkerSizes(newSize)
	markerSize = math.clamp(math.round(newSize), 28, 56); markerSizeBox.Text = tostring(markerSize)
	for _, m in ipairs(markers) do if m.frame and m.frame.Parent then m.frame.Size = UDim2.new(0, markerSize, 0, markerSize) end end
end

local function pulseMarker(markerObj)
	if not showClickPulse then return end
	local holder = markerObj and markerObj.frame
	if not holder or not holder.Parent or not markerObj.enabled then return end
	local origColor = markerObj.color
	holder.BackgroundColor3 = Color3.fromRGB(110, 255, 160)
	tweenProp(holder, { BackgroundColor3 = origColor }, 0.14)
end

local function clearAllMarkers()
	selectedMarker = nil; markerPanel.Visible = false
	for _, m in ipairs(markers) do if m.frame and m.frame.Parent then m.frame:Destroy() end end
	table.clear(markers); statusLabel.Text = "Все точки удалены"
end

local function addMarker(preset)
	local index = #markers + 1
