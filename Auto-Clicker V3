-- ====================== КЛИКИ ======================

local lastClickTimes = {}
local clickThread = nil

local function doClick(pos)
	-- Более точный клик по центру
	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
	task.wait()
	VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
end

local function stopClicking()
	isRunning = false
	startStopBtn.Text = "▶  СТАРТ"
	startStopBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
end

local function startClicking()
	if isRunning then return end
	if #points == 0 then return end

	isRunning = true
	startStopBtn.Text = "■  СТОП"
	startStopBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)

	clickThread = task.spawn(function()
		while isRunning do
			if mode == "Separate" then
				local now = tick()
				for _, point in ipairs(points) do
					if point.enabled and point.visual then
						local last = lastClickTimes[point.id] or 0
						if (now - last) * 1000 >= point.intervalMs then
							-- Берём актуальную позицию
							local pos = Vector2.new(
								point.visual.AbsolutePosition.X + point.visual.AbsoluteSize.X / 2,
								point.visual.AbsolutePosition.Y + point.visual.AbsoluteSize.Y / 2
							)
							doClick(pos)
							lastClickTimes[point.id] = now
						end
					end
				end
				task.wait(0.01)
			else
				local sorted = {}
				for _, p in ipairs(points) do
					if p.enabled and p.visual then table.insert(sorted, p) end
				end
				table.sort(sorted, function(a, b) return a.order < b.order end)

				for _, point in ipairs(sorted) do
					if not isRunning then break end
					local pos = Vector2.new(
						point.visual.AbsolutePosition.X + point.visual.AbsoluteSize.X / 2,
						point.visual.AbsolutePosition.Y + point.visual.AbsoluteSize.Y / 2
					)
					doClick(pos)
					task.wait(point.intervalMs / 1000)
				end
			end
		end
	end)
end

