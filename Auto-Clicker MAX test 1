	local holder = markerObj and markerObj.frame
	if not holder or not holder.Parent or not markerObj.enabled then
		return
	end
	pcall(function()
		local origColor = markerObj.color
		holder.BackgroundColor3 = Color3.fromRGB(90, 250, 145)
		TweenService:Create(holder, TweenInfo.new(0.12), { BackgroundColor3 = origColor }):Play()
	end)
end

