local function parseOffsetText(txt, prefix)
	local val = tonumber(string.gsub(txt or "", "[^%d%-]", ""))
	if val then
		val = math.clamp(math.round(val), -300, 300)
		return val, prefix .. ": " .. tostring(val)
	end
	return nil, nil
end

