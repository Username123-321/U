end))

task.spawn(function()
	while not destroyed do
		if isRunning and #markers > 0 then
			if runMode == "TOGETHER" then
				for i = 1, #markers do
					if not isRunning or destroyed or runMode ~= "TOGETHER" then break end
					local item = markers[i]
					if item and item.enabled then
						local clicked = executeMarkerClick(item)
						if clicked then
							local baseSec = item.customIntervalSec or defaultIntervalSec
							task.wait(getRandomizedInterval(baseSec))
						end
					end
				end
				task.wait(0.01)
			else
				local now, clickedAny = os.clock(), false
				for i = 1, #markers do
					if not isRunning or destroyed or runMode ~= "SEPARATE" then break end
					local item = markers[i]
					if item and item.enabled then
						local interval = item.customIntervalSec or defaultIntervalSec
						if (now - item.lastClickClock) >= interval then
							if executeMarkerClick(item) then
								clickedAny = true
							end
						end
					end
				end
				task.wait(clickedAny and 0.01 or 0.02)
			end
		else
			task.wait(0.05)
		end
	end
end)

