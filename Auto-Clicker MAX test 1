local function rgbToHex(c)
	local r = math.clamp(math.round(c.R * 255), 0, 255)
	local g = math.clamp(math.round(c.G * 255), 0, 255)
	local b = math.clamp(math.round(c.B * 255), 0, 255)
	return string.format("#%02X%02X%02X", r, g, b)
end

local function hexToColor3(str)
	if not str then
		return nil
	end
	local clean = string.gsub(str, "[#%s]", "")
	if #clean == 3 then
		clean = string.sub(clean, 1, 1):rep(2)
			.. string.sub(clean, 2, 2):rep(2)
			.. string.sub(clean, 3, 3):rep(2)
	end
	if #clean ~= 6 or string.match(clean, "[^%x]") then
		return nil
	end
	local r = tonumber(string.sub(clean, 1, 2), 16)
	local g = tonumber(string.sub(clean, 3, 4), 16)
	local b = tonumber(string.sub(clean, 5, 6), 16)
	return Color3.fromRGB(r, g, b)
end

local function makeDraggableOrClickable(dragHandle, targetFrame, onClickWithoutDrag)
	local dragging = false
	local movedFar = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	trackConn(dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			movedFar = false
			dragStart = input.Position
			startPos = targetFrame.Position
			dragInput = input

			local endConn
			endConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					local wasTap = dragging and not movedFar
					dragging = false
					if endConn then
						endConn:Disconnect()
					end
					if wasTap and onClickWithoutDrag then
						onClickWithoutDrag()
					end
				end
			end)
		end
	end))

	trackConn(dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end))

	trackConn(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			if delta.Magnitude > 5 then
				movedFar = true
			end
			if movedFar then
				targetFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end
	end))
end

local function cleanupAll()
	if destroyed then
		return
	end
	destroyed = true
	isRunning = false
	runToken += 1

	for _, conn in ipairs(connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(connections)

	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end

	if _G[GLOBAL_CLEANUP_KEY] == cleanupAll then
		_G[GLOBAL_CLEANUP_KEY] = nil
	end
end

_G[GLOBAL_CLEANUP_KEY] = cleanupAll

