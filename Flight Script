-- ЛОГИКА ПЕРЕМЕЩЕНИЯ И ИЗМЕНЕНИЯ РАЗМЕРА
---------------------------------------------------------------------------
local dragging, resizing = false, false
local dragInput, resizeInput
local dragStart, startPos, startSize

local function isNearEdge(inputPos, frame)
	local absPos = frame.AbsolutePosition
	local absSize = frame.AbsoluteSize
	local threshold = 25
	local x = inputPos.X
	local y = inputPos.Y
	
	if x >= absPos.X and x <= absPos.X + absSize.X and y >= absPos.Y and y <= absPos.Y + absSize.Y then
		if y <= absPos.Y + 35 or x <= absPos.X + threshold or x >= absPos.X + absSize.X - threshold or y >= absPos.Y + absSize.Y - threshold then
			return true
		end
	end
	return false
end

mainFrame.InputBegan:Connect(function(input)
	if confirmOverlay.Visible then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local mousePos = Vector2.new(input.Position.X, input.Position.Y)
		
		local handlePos = resizeHandle.AbsolutePosition
		local handleSize = resizeHandle.AbsoluteSize
		if mousePos.X >= handlePos.X - 10 and mousePos.X <= handlePos.X + handleSize.X + 10 and
		   mousePos.Y >= handlePos.Y - 10 and mousePos.Y <= handlePos.Y + handleSize.Y + 10 then
			resizing = true
			resizeInput = input
			startSize = mainFrame.AbsoluteSize
			dragStart = mousePos
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
				end
			end)
			return
		end
		
		if isNearEdge(mousePos, mainFrame) then
			dragging = true
			dragInput = input
			dragStart = mousePos
			startPos = mainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	elseif input == resizeInput and resizing then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
		local newX = math.clamp(startSize.X + delta.X, 260, 600)
		local newY = math.clamp(startSize.Y + delta.Y, 190, 400)
		mainFrame.Size = UDim2.new(0, newX, 0, newY)
	end
end)

