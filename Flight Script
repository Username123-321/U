local flightEnabled = false
local currentSpeed = 50

local function updateSpeed()
	local val = tonumber(speedBox.Text)
	if val then
		currentSpeed = val
		speedBox.Text = tostring(currentSpeed)
	else
		speedBox.Text = tostring(currentSpeed)
	end
end

applyButton.MouseButton1Click:Connect(updateSpeed)
speedBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then updateSpeed() end
end)

local char, hrp, humanoid
local bv, bg
local flightConnection = nil

local function stopFlight()
	if flightConnection then
		flightConnection:Disconnect()
		flightConnection = nil
	end
	if bv then bv:Destroy() bv = nil end
	if bg then bg:Destroy() bg = nil end
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.PlatformStand = false
	end
end

local function startFlight()
	stopFlight()
	
	char = player.Character
	if not char then return end
	hrp = char:FindFirstChild("HumanoidRootPart")
	humanoid = char:FindFirstChild("Humanoid")
	if not hrp or not humanoid then return end
	
	humanoid.PlatformStand = true
	
	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp
	
	bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bg.P = 20000
	bg.Parent = hrp
	
	flightConnection = RunService.RenderStepped:Connect(function()
		if not hrp or not humanoid or not hrp.Parent then return end
		
		local camera = workspace.CurrentCamera
		local moveDir = humanoid.MoveDirection
		local velocity = Vector3.new(0, 0, 0)
		
		if moveDir.Magnitude > 0 then
			local camSpace = camera.CFrame:VectorToObjectSpace(moveDir)
			velocity = (camera.CFrame.RightVector * camSpace.X + camera.CFrame.LookVector * (-camSpace.Z)) * currentSpeed
		else
			velocity = Vector3.new(0, 0, 0)
		end
		
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			velocity = velocity + Vector3.new(0, currentSpeed, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
			velocity = velocity - Vector3.new(0, currentSpeed, 0)
		end
		
		bv.Velocity = velocity
		bg.CFrame = camera.CFrame
	end)
end

local function setFlightState(state)
	flightEnabled = state
	local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if flightEnabled then
		TweenService:Create(switchButton, info, {BackgroundColor3 = Color3.fromRGB(80, 200, 120)}):Play()
		TweenService:Create(switchCircle, info, {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
		startFlight()
	else
		TweenService:Create(switchButton, info, {BackgroundColor3 = Color3.fromRGB(220, 50, 50)}):Play()
		TweenService:Create(switchCircle, info, {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
		stopFlight()
	end
end

switchButton.MouseButton1Click:Connect(function()
	setFlightState(not flightEnabled)
end)

local function shutdown()
	stopFlight()
	screenGui:Destroy()
end

yesButton.MouseButton1Click:Connect(shutdown)

player.CharacterAdded:Connect(function(newChar)
	if flightEnabled then
		setFlightState(false)
	end
end)
