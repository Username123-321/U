local function makeTab(index, total, name)
    local btn = Instance.new("TextButton", tabsFrame)
    local w = 1 / total
    btn.Size = UDim2.new(w - 0.01, 0, 1, 0)
    btn.Position = UDim2.new((index - 1) * w, 0, 0, 0)
    btn.BackgroundColor3 = (index == 1) and Color3.fromRGB(45, 45, 60) or Color3.fromRGB(25, 25, 33)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local page = Instance.new("ScrollingFrame", main)
    page.Size = UDim2.new(1, -16, 1, -85)
    page.Position = UDim2.new(0, 8, 0, 78)
    page.BackgroundTransparency = 1
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.Visible = (index == 1)
    
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    btn.MouseButton1Click:Connect(function()
        for i, p in ipairs(pages) do
            p.page.Visible = (i == index)
            p.btn.BackgroundColor3 = (i == index) and Color3.fromRGB(45, 45, 60) or Color3.fromRGB(25, 25, 33)
        end
    end)
    
    table.insert(pages, {btn = btn, page = page})
    return page
end

