        Portals = deepCopy(portalsData),
        Settings = { ClickTpActive = clickTpActive }
    }
    
    local found = false
    for _, cfg in ipairs(savedConfigsList) do
        if cfg.Name == cName then
            cfg.Points = configData.Points
            cfg.Portals = configData.Portals
            cfg.Settings = configData.Settings
            found = true
            break
        end
