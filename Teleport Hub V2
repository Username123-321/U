    preview.BackgroundColor3 = initialColor
    Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)
    
    local btn = Instance.new("TextButton", holder)
    btn.Size = UDim2.new(1, -36, 1, 0)
    btn.Position = UDim2.new(0, 32, 0, 0)
    btn.BackgroundTransparency = 1
    btn.Text = "Изменить цвет"
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local popup = Instance.new("Frame", main)
    popup.Size = UDim2.new(0, 300, 0, 300)
    popup.Position = UDim2.new(0.5, -150, 0.5, -150)
    popup.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    popup.Visible = false
    popup.ZIndex = 10
    Instance.new("UICorner", popup).CornerRadius = UDim.new(0, 10)
    Instance.new("UIStroke", popup).Color = Color3.fromRGB(80, 80, 110)
    makeDraggable(popup)
    
    local pTitle = Instance.new("TextLabel", popup)
    pTitle.Size = UDim2.new(1, -40, 0, 28)
    pTitle.Position = UDim2.new(0, 10, 0, 5)
    pTitle.BackgroundTransparency = 1
    pTitle.Text = "Выбор цвета"
    pTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    pTitle.TextSize = 12
    pTitle.Font = Enum.Font.GothamBold
    pTitle.TextXAlignment = Enum.TextXAlignment.Left
    
    local pClose = Instance.new("TextButton", popup)
    pClose.Size = UDim2.new(0, 24, 0, 24)
    pClose.Position = UDim2.new(1, -28, 0, 5)
    pClose.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
    pClose.Text = "×"
    pClose.TextColor3 = Color3.fromRGB(255, 120, 120)
    pClose.TextSize = 14
    Instance.new("UICorner", pClose).CornerRadius = UDim.new(0, 4)
    pClose.MouseButton1Click:Connect(function() popup.Visible = false end)
    
    -- Палитра кнопок
    local palette = Instance.new("Frame", popup)
    palette.Size = UDim2.new(1, -20, 0, 100)
    palette.Position = UDim2.new(0, 10, 0, 38)
    palette.BackgroundTransparency = 1
    local pgrid = Instance.new("UIGridLayout", palette)
    pgrid.CellSize = UDim2.new(0, 44, 0, 22)
    pgrid.CellPadding = UDim2.new(0, 4, 0, 4)
    
    local current = initialColor
    local function apply(c)
        current = c
        preview.BackgroundColor3 = c
        if onChanged then onChanged(c) end
    end
    
    for _, entry in ipairs(PRESET_COLORS) do
        local b = Instance.new("TextButton", palette)
        b.BackgroundColor3 = entry.c
        b.Text = ""
        b.BorderSizePixel = 1
        b.BorderColor3 = Color3.fromRGB(90,90,90)
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 3)
        b.MouseEnter:Connect(function() b.BorderColor3 = Color3.fromRGB(255,255,255) end)
        b.MouseLeave:Connect(function() b.BorderColor3 = Color3.fromRGB(90,90,90) end)
        b.MouseButton1Click:Connect(function() apply(entry.c) end)
    end
    
    -- Круговой селектор (Hue slider через драг)
    local ringHolder = Instance.new("Frame", popup)
    ringHolder.Size = UDim2.new(0, 90, 0, 90)
    ringHolder.Position = UDim2.new(0, 10, 0, 145)
    ringHolder.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    ringHolder.ClipsDescendants = true
    Instance.new("UICorner", ringHolder).CornerRadius = UDim.new(1, 0)
    
    local ringDot = Instance.new("Frame", ringHolder)
    ringDot.Size = UDim2.new(0, 14, 0, 14)
    ringDot.BackgroundColor3 = current
    ringDot.AnchorPoint = Vector2.new(0.5, 0.5)
    ringDot.Position = UDim2.new(0.5, 0, 0.5, 0)
    Instance.new("UICorner", ringDot).CornerRadius = UDim.new(1, 0)
    
    local ringActive = false
    local function updateRingFromPos(mx, my)
        local abs = ringHolder.AbsolutePosition
        local sz = ringHolder.AbsoluteSize
        local cx, cy = abs.X + sz.X/2, abs.Y + sz.Y/2
        local dx, dy = mx - cx, my - cy
        local angle = math.atan2(dy, dx)
        local radius = sz.X/2 - 8
        local px = math.cos(angle) * radius
        local py = math.sin(angle) * radius
        ringDot.Position = UDim2.new(0.5, px, 0.5, py)
        local hue = (angle / (math.pi*2)) % 1
        local c = Color3.fromHSV(hue, 1, 1)
        apply(c)
    end
    ringHolder.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            ringActive = true
            updateRingFromPos(i.Position.X, i.Position.Y)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if ringActive and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateRingFromPos(i.Position.X, i.Position.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            ringActive = false
        end
    end)
    
    -- HEX / RGB ввод
    local hexBox = Instance.new("TextBox", popup)
    hexBox.Size = UDim2.new(0, 130, 0, 26)
    hexBox.Position = UDim2.new(0, 108, 0, 150)
    hexBox.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    hexBox.Text = colorToHex(current)
    hexBox.PlaceholderText = "HEX (напр. FF8800)"
    hexBox.TextColor3 = Color3.fromRGB(255,255,255)
    hexBox.TextSize = 11
    hexBox.ClearTextOnFocus = false
    Instance.new("UICorner", hexBox).CornerRadius = UDim.new(0, 4)
    hexBox.FocusLost:Connect(function()
        local c = hexToColor(hexBox.Text)
        if c then apply(c) else hexBox.Text = colorToHex(current) end
    end)
    
    local rgbBox = Instance.new("TextBox", popup)
    rgbBox.Size = UDim2.new(0, 130, 0, 26)
    rgbBox.Position = UDim2.new(0, 108, 0, 182)
    rgbBox.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    rgbBox.Text = colorToRgbString(current)
    rgbBox.PlaceholderText = "RGB (255,140,0)"
    rgbBox.TextColor3 = Color3.fromRGB(255,255,255)
    rgbBox.TextSize = 11
    rgbBox.ClearTextOnFocus = false
    Instance.new("UICorner", rgbBox).CornerRadius = UDim.new(0, 4)
    rgbBox.FocusLost:Connect(function()
        local c = rgbStringToColor(rgbBox.Text)
        if c then apply(c) else rgbBox.Text = colorToRgbString(current) end
    end)
    
    -- Синхронизация полей при изменении
    local function syncFields()
        hexBox.Text = colorToHex(current)
        rgbBox.Text = colorToRgbString(current)
        preview.BackgroundColor3 = current
    end
    -- Переопределяем apply, чтобы обновлять поля
    local applyOld = apply
    apply = function(c)
        applyOld(c)
        syncFields()
    end
    
    local okBtn = Instance.new("TextButton", popup)
    okBtn.Size = UDim2.new(1, -20, 0, 28)
    okBtn.Position = UDim2.new(0, 10, 1, -36)
    okBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 60)
    okBtn.Text = "Применить"
    okBtn.TextColor3 = Color3.fromRGB(255,255,255)
    okBtn.TextSize = 12
    Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 6)
    okBtn.MouseButton1Click:Connect(function()
        if onChanged then onChanged(current) end
        popup.Visible = false
    end)
    
    btn.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
        if popup.Visible then
            hexBox.Text = colorToHex(current)
            rgbBox.Text = colorToRgbString(current)
        end
    end)
    
    return holder
end
