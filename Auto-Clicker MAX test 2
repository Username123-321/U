local function openMarkerSettings(markerObj)
	selectedMarker = markerObj
	refreshMarkerSelectionVisuals()
	markerPanel.Visible = true
	mpTitle.Text = "Настройки точки #" .. tostring(markerObj.index)
	togglePointBtn.Text = markerObj.enabled and "Точка: ВКЛЮЧЕНА" or "Точка: ВЫКЛЮЧЕНА"
	togglePointBtn.BackgroundColor3 = markerObj.enabled and Color3.fromRGB(42, 145, 82) or Color3.fromRGB(145, 55, 62)
	local ms = markerObj.customIntervalSec and math.round(markerObj.customIntervalSec * 1000) or math.round(defaultIntervalSec * 1000)
	pointIntBox.Text = tostring(ms)
	pointLimitBox.Text = tostring(markerObj.pointLimit or 0)
	syncColorPanelFromColor(markerObj.color)
end

local pickingWheel = false
local function updateWheelAt(pos2D)
	local absPos = wheelHolder.AbsolutePosition
	local absSize = wheelHolder.AbsoluteSize
	local dx = pos2D.X - (absPos.X + absSize.X * 0.5)
	local dy = pos2D.Y - (absPos.Y + absSize.Y * 0.5)
	local dist = math.clamp(math.sqrt(dx * dx + dy * dy) / (absSize.X * 0.5), 0.08, 1)
	local angle = math.atan2(dy, dx)
	if angle < 0 then
		angle += math.pi * 2
	end
	currentHue = angle / (math.pi * 2)
	currentSat = dist
	if selectedMarker then
		applyMarkerColor(selectedMarker, Color3.fromHSV(currentHue, currentSat, currentVal))
	end
end

trackConn(wheelHolder.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		pickingWheel = true
		updateWheelAt(input.Position)
	end
end))
trackConn(UserInputService.InputChanged:Connect(function(input)
	if pickingWheel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateWheelAt(input.Position)
	end
end))
trackConn(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		pickingWheel = false
	end
end))
trackConn(valBar.MouseButton1Click:Connect(function()
	currentVal -= 0.2
	if currentVal < 0.25 then currentVal = 1.0 end
	if selectedMarker then applyMarkerColor(selectedMarker, Color3.fromHSV(currentHue, currentSat, currentVal)) end
end))

local function applyRGBInputs()
	if syncingColorUI or not selectedMarker then return end
	local r = tonumber(string.match(rBox.Text or "", "%-?%d+"))
	local g = tonumber(string.match(gBox.Text or "", "%-?%d+"))
	local b = tonumber(string.match(bBox.Text or "", "%-?%d+"))
	if r and g and b then
		applyMarkerColor(selectedMarker, Color3.fromRGB(math.clamp(math.round(r), 0, 255), math.clamp(math.round(g), 0, 255), math.clamp(math.round(b), 0, 255)))
	else
		syncColorPanelFromColor(selectedMarker.color)
	end
end

trackConn(rBox.FocusLost:Connect(applyRGBInputs))
trackConn(gBox.FocusLost:Connect(applyRGBInputs))
trackConn(bBox.FocusLost:Connect(applyRGBInputs))
trackConn(hexBox.FocusLost:Connect(function()
	if syncingColorUI or not selectedMarker then return end
	local parsed = hexToColor3(hexBox.Text)
	if parsed then applyMarkerColor(selectedMarker, parsed) else hexBox.Text = rgbToHex(selectedMarker.color) end
end))
trackConn(togglePointBtn.MouseButton1Click:Connect(function()
	if not selectedMarker then return end
	selectedMarker.enabled = not selectedMarker.enabled
	refreshMarkerVisualState(selectedMarker)
	openMarkerSettings(selectedMarker)
end))
trackConn(pointIntBox.FocusLost:Connect(function()
	if not selectedMarker then return end
	local num = tonumber(pointIntBox.Text)
	if num then
		num = math.clamp(num, 15, 60000)
		selectedMarker.customIntervalSec = num / 1000
		pointIntBox.Text = tostring(math.round(num))
	else
		pointIntBox.Text = tostring(selectedMarker.customIntervalSec and math.round(selectedMarker.customIntervalSec * 1000) or math.round(defaultIntervalSec * 1000))
	end
end))
trackConn(pointLimitBox.FocusLost:Connect(function()
	if not selectedMarker then return end
