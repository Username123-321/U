end

local function setRunningState(state)
	if state == isRunning then return end
	runToken += 1
	local currentToken = runToken
	if state then
		if clickLimit > 0 and clickCount >= clickLimit then clickCount = 0 end
		local function activateNow()
			if destroyed or runToken ~= currentToken then return end
			isRunning = true
			local now = os.clock()
			for _, m in ipairs(markers) do m.lastClickClock = now - 999 end
			if autoMinimizeOnStart then setMinimizedState(true) end
			startBtn.Text = "Стоп"; startBtn.BackgroundColor3 = Color3.fromRGB(185, 52, 60)
			miniPill.Text = "AC v6 [РАБОТАЕТ]"; miniPill.TextColor3 = Color3.fromRGB(120, 240, 145)
			updateCounterTitle()
			statusLabel.Text = "Запущено | X:" .. tostring(userOffsetX) .. " Y:" .. tostring(userOffsetY)
		end
		if startDelaySec > 0 then
			statusLabel.Text = string.format("Старт через %.1f с...", startDelaySec)
			task.delay(startDelaySec, activateNow)
		else
			activateNow()
		end
	else
		isRunning = false
		startBtn.Text = "Начать"; startBtn.BackgroundColor3 = Color3.fromRGB(42, 145, 82)
		miniPill.Text = "AC v6 [Открыть]"; miniPill.TextColor3 = Color3.fromRGB(220, 225, 235)
		updateCounterTitle()
		statusLabel.Text = "Остановлено"
	end
end

-- Новая математика: 0, 0 в интерфейсе = BASE_OFFSET_X (35), BASE_OFFSET_Y (105)
local function executeMarkerClick(markerObj, ignoreRunningCheck)
	if not markerObj or not markerObj.frame or not markerObj.frame.Parent then return false end
	if not ignoreRunningCheck then
		if not markerObj.enabled then return false end
		if clickLimit > 0 and clickCount >= clickLimit then setRunningState(false); statusLabel.Text = "Достигнут лимит кликов"; return false end
		if markerObj.pointLimit and markerObj.pointLimit > 0 and (markerObj.pointClicks or 0) >= markerObj.pointLimit then return false end
	end
	local pos = markerObj.frame.AbsolutePosition
	local size = markerObj.frame.AbsoluteSize
	local insetY = 0
	if useTopInsetFix then pcall(function() insetY = GuiService:GetGuiInset().Y end) end
	local rndX = jitterPx > 0 and math.random(-jitterPx, jitterPx) or 0
	local rndY = jitterPx > 0 and math.random(-jitterPx, jitterPx) or 0
	local finalX = math.round(pos.X + size.X * 0.5 + BASE_OFFSET_X + userOffsetX + rndX)
	local finalY = math.round(pos.Y + size.Y * 0.5 - insetY + BASE_OFFSET_Y + userOffsetY + rndY)

	clickCount += 1
	markerObj.pointClicks = (markerObj.pointClicks or 0) + 1
	markerObj.lastClickClock = os.clock()
	updateCounterTitle()
	pulseMarker(markerObj)

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 1)
		task.wait(math.max(0.005, holdSec))
		VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 1)
	end)
	if not ignoreRunningCheck and clickLimit > 0 and clickCount >= clickLimit then setRunningState(false); statusLabel.Text = "Лимит кликов выполнен" end
	return true
end

local function getRandomizedInterval(baseSec)
	if jitterMs <= 0 then return baseSec end
	return math.max(0.01, baseSec + (math.random(-jitterMs, jitterMs) / 1000))
end

