local function syncColorPanelFromColor(c)
	syncingColorUI = true
	local h, s, v = c:ToHSV()
	currentHue = h
	currentSat = math.max(s, 0.05)
	currentVal = v

	rBox.Text = tostring(math.clamp(math.round(c.R * 255), 0, 255))
	gBox.Text = tostring(math.clamp(math.round(c.G * 255), 0, 255))
	bBox.Text = tostring(math.clamp(math.round(c.B * 255), 0, 255))
	hexBox.Text = rgbToHex(c)

	local angle = h * math.pi * 2
	local radiusNorm = math.clamp(s, 0, 1) * 0.45
	wheelKnob.Position = UDim2.new(0.5 + math.cos(angle) * radiusNorm, -5, 0.5 + math.sin(angle) * radiusNorm, -5)
	syncingColorUI = false
end

function applyMarkerColor(markerObj, newColor)
	if not markerObj or not markerObj.frame or not markerObj.frame.Parent then
		return
	end
	markerObj.color = newColor
	if markerObj.enabled then
		markerObj.frame.BackgroundColor3 = newColor
	end
	if selectedMarker == markerObj then
		syncColorPanelFromColor(newColor)
	end
end

