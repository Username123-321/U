	dragBtn.TextColor3 = Color3.fromRGB(15, 15, 15); dragBtn.TextSize = 14; dragBtn.Font = Enum.Font.GothamBlack; dragBtn.ZIndex = 51; dragBtn.Parent = holder

	local delBtn = Instance.new("TextButton")
	delBtn.Size = UDim2.new(0, 16, 0, 16); delBtn.Position = UDim2.new(1, -4, 0, -4)
	delBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50); delBtn.Text = "×"; delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	delBtn.TextSize = 11; delBtn.Font = Enum.Font.GothamBold; delBtn.ZIndex = 52; delBtn.Parent = holder
	local delCorner = Instance.new("UICorner"); delCorner.CornerRadius = UDim.new(1, 0); delCorner.Parent = delBtn

	local entry = {
		index = index, frame = holder, dragBtn = dragBtn, label = dragBtn, stroke = stroke, delBtn = delBtn,
		enabled = true, color = initColor, customIntervalSec = nil, pointLimit = 0, pointClicks = 0, lastClickClock = 0
	}
