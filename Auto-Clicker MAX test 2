	holder.Size = UDim2.new(0, markerSize, 0, markerSize)
	holder.Position = UDim2.new(0.5, -markerSize / 2 + (index - 1) * 14, 0.55, -markerSize / 2)
	holder.BackgroundColor3 = initColor
	holder.BackgroundTransparency = 0.2
	holder.BorderSizePixel = 0
	holder.ZIndex = 50
	holder.Parent = markersFolder

	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = holder
	local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(25, 28, 35); stroke.Thickness = 1.5; stroke.Parent = holder

	local dragBtn = Instance.new("TextButton")
