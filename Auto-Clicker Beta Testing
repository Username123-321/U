local function ReadNumber(input, oldValue, minimum, maximum)
    local value = tonumber(input.Text)

    if not value or value ~= value then
        input.Text = tostring(oldValue)
        return oldValue
    end

    value = math.clamp(value, minimum, maximum)
    input.Text = tostring(value)

    return value
end

local function UpdateSettings()
    State.Interval = ReadNumber(
        SpeedInput,
        State.Interval,
        0.01,
        60
    )

    State.HoldTime = ReadNumber(
        HoldInput,
        State.HoldTime,
        0.005,
        5
    )

    State.StartDelay = ReadNumber(
        DelayInput,
        State.StartDelay,
        0,
        3600
    )

    State.ClickLimit = math.floor(ReadNumber(
        LimitInput,
        State.ClickLimit,
        0,
        1000000
    ))

    State.MarkerSize = math.floor(ReadNumber(
        MarkerSizeInput,
        State.MarkerSize,
        20,
        90
    ))

    State.OffsetX = ReadNumber(
        OffsetXInput,
        State.OffsetX,
        -500,
        500
    )

    State.OffsetY = ReadNumber(
        OffsetYInput,
        State.OffsetY,
        -500,
        500
    )

    UpdateMarkerSize()
    SetStatus("Настройки обновлены")
end

local function CycleRunMode()
    if State.RunMode == "TOGETHER" then
        State.RunMode = "SEQUENCE"
        ModeButton.Text = "РЕЖИМ: ПО ОЧЕРЕДИ"
    else
        State.RunMode = "TOGETHER"
        ModeButton.Text = "РЕЖИМ: ВСЕ ТОЧКИ"
    end
end

local function CycleActionMode()
    if State.ActionMode == "CLICK" then
        State.ActionMode = "HOLD"
        ActionButton.Text = "ДЕЙСТВИЕ: УДЕРЖАНИЕ"
    else
        State.ActionMode = "CLICK"
        ActionButton.Text = "ДЕЙСТВИЕ: КЛИК"
    end
end

