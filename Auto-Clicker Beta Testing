local function UpdateMarkerList()
    for _, child in ipairs(MarkerList:GetChildren()) do
        child:Destroy()
    end

    for index, marker in ipairs(State.Markers) do
        local button = New("TextButton", {
            Size = UDim2.new(1, -4, 0, 26),
            Position = UDim2.fromOffset(2, (index - 1) * 29),
            BackgroundColor3 =
                State.SelectedMarker == marker
                and Color3.fromRGB(45, 115, 190)
                or Themes.DARK.Card,

            Text = "Точка " .. index,
            TextColor3 = Themes.DARK.Text,
            TextSize = 11,
            Font = Enum.Font.GothamBold
        }, MarkerList)

        Round(button, 5)

        ConnectButton(button, function()
            State.SelectedMarker = marker
            UpdateMarkerList()
        end)
    end

    StatsLabel.Text =
        "Кликов: " .. State.ClickCount ..
        "\nТочек: " .. #State.Markers ..
        "\nСтатус: " ..
        (State.Running and "Работает" or "Остановлен")
end

local function CreateMarker(position)
    if #State.Markers >= 50 then
        SetStatus("Достигнут лимит точек")
        return
    end

    local marker = {
        X = position and position.X or 0.5,
        Y = position and position.Y or 0.5,
        Enabled = true,
        Color = Color3.fromRGB(60, 160, 255),
        Object = nil
    }

    local visual = New("TextButton", {
        Name = "Marker_" .. (#State.Markers + 1),
        Size = UDim2.fromOffset(
            State.MarkerSize,
            State.MarkerSize
        ),
        Position = UDim2.new(
            marker.X,
            0,
            marker.Y,
            0
        ),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = marker.Color,
        Text = tostring(#State.Markers + 1),
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        Active = true,
        ZIndex = 10
    }, MarkerFolder)

    Round(visual, 100)
    Stroke(visual, Color3.new(1, 1, 1), 1.5)

    marker.Object = visual

    table.insert(State.Markers, marker)
    State.SelectedMarker = marker

    local dragging = false
    local dragStart
    local startPosition
    local activeInput

    Track(visual.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = visual.Position
            activeInput = input
        end
    end))

    Track(UIS.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        local newX = startPosition.X.Offset + delta.X
        local newY = startPosition.Y.Offset + delta.Y

        visual.Position = UDim2.new(
            startPosition.X.Scale,
            newX,
            startPosition.Y.Scale,
            newY
        )

        local absolute = visual.AbsolutePosition
        local screenSize = Screen.AbsoluteSize

        marker.X = math.clamp(
            (absolute.X + visual.AbsoluteSize.X / 2)
            / screenSize.X,
            0,
            1
        )

        marker.Y = math.clamp(
            (absolute.Y + visual.AbsoluteSize.Y / 2)
            / screenSize.Y,
            0,
            1
        )
    end))

    Track(UIS.InputEnded:Connect(function(input)
        if input == activeInput
            or input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
            activeInput = nil
        end
    end))

    Track(visual.Activated:Connect(function()
        State.SelectedMarker = marker
        UpdateMarkerList()
    end))

    UpdateMarkerList()
    SetStatus("Добавлена точка " .. #State.Markers)
end

local function RemoveSelectedMarker()
    local marker = State.SelectedMarker

    if not marker then
        SetStatus("Сначала выбери точку")
        return
    end

    if marker.Object then
        marker.Object:Destroy()
    end

    for index, item in ipairs(State.Markers) do
        if item == marker then
            table.remove(State.Markers, index)
            break
        end
    end

    State.SelectedMarker = State.Markers[1]

    UpdateMarkerList()
    SetStatus("Точка удалена")
end

local function UpdateMarkerSize()
    for _, marker in ipairs(State.Markers) do
        if marker.Object then
            marker.Object.Size = UDim2.fromOffset(
                State.MarkerSize,
                State.MarkerSize
            )
        end
    end
end

