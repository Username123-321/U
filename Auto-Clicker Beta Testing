-- ==========================================
-- 1. SAFE CLICK ENGINE
-- ==========================================

local VirtualInputManager =
    game:GetService("VirtualInputManager")

local VirtualUser =
    game:GetService("VirtualUser")

local function GetScreenPosition(marker)
    local screenSize = Screen.AbsoluteSize

    local x = marker.X * screenSize.X + State.OffsetX
    local y = marker.Y * screenSize.Y + State.OffsetY

    return Vector2.new(
        math.clamp(x, 0, screenSize.X),
        math.clamp(y, 0, screenSize.Y)
    )
end

local function SendMouseButton(position, down)
    local success = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(
            position.X,
            position.Y,
            0,
            down,
            game,
            0
        )
    end)

    if not success then
        return false
    end

    return true
end

local function PerformClick(marker)
    if State.Destroyed or not State.Running then
        return false
    end

    local position = GetScreenPosition(marker)

    if not SendMouseButton(position, true) then
        return false
    end

    if State.ActionMode == "HOLD" then
        task.wait(State.HoldTime)
    else
        task.wait(0.01)
    end

    SendMouseButton(position, false)

    State.ClickCount += 1

    return true
end

-- ==========================================
-- 2. MARKER VALIDATION
-- ==========================================

local function GetActiveMarkers()
    local result = {}

    for _, marker in ipairs(State.Markers) do
        if marker.Enabled and marker.Object
            and marker.Object.Parent then

            table.insert(result, marker)
        end
    end

    return result
end

-- ==========================================
-- 3. ENGINE CONTROL
-- ==========================================

local function WaitInterval(token)
    local interval = State.Interval

    if State.Turbo then
        interval = math.max(interval * 0.5, 0.01)
    end

    if State.JitterMs > 0 then
        interval += math.random(
            0,
            State.JitterMs
        ) / 1000
    end

    local finish = os.clock() + interval

    while os.clock() < finish do
        if State.Destroyed
            or not State.Running
            or token ~= State.RunToken then

            return false
        end

        task.wait(0.01)
    end

    return true
end

local function WaitStartDelay(token)
    local finish = os.clock() + State.StartDelay

    while os.clock() < finish do
        if State.Destroyed
            or not State.Running
            or token ~= State.RunToken then

            return false
        end

        task.wait(0.05)
    end

    return true
end

local function CanContinue(token)
    if State.Destroyed then
        return false
    end

    if not State.Running then
        return false
    end

    if token ~= State.RunToken then
        return false
    end

    if State.ClickLimit > 0
        and State.ClickCount >= State.ClickLimit then

        return false
    end

    return true
end

local function RunTogether(token)
    while CanContinue(token) do
        local markers = GetActiveMarkers()

        if #markers == 0 then
            SetStatus("Нет активных точек")
            break
        end

        for _, marker in ipairs(markers) do
            if not CanContinue(token) then
                break
            end

            if State.ClickLimit > 0
                and State.ClickCount >= State.ClickLimit then
                break
            end

            PerformClick(marker)
        end

        if not WaitInterval(token) then
            break
        end
    end
end

local function RunSequence(token)
    while CanContinue(token) do
        local markers = GetActiveMarkers()

        if #markers == 0 then
            SetStatus("Нет активных точек")
            break
        end

        for _, marker in ipairs(markers) do
            if not CanContinue(token) then
                break
            end

            if State.ClickLimit > 0
                and State.ClickCount >= State.ClickLimit then
                break
            end

            PerformClick(marker)

            if not WaitInterval(token) then
                break
            end
        end

        if State.CycleGap > 0 then
            task.wait(State.CycleGap)
        end
    end
end

-- ==========================================
-- 4. START / STOP
-- ==========================================

function StopAutoClicker()
    if not State.Running then
        return
    end

    State.Running = false
    State.RunToken += 1

    SetStatus("Автокликер остановлен")

    UpdateMarkerList()
end

function StartAutoClicker()
    if State.Destroyed then
        return
    end

    if State.Running then
        return
    end

    if #GetActiveMarkers() == 0 then
        SetStatus("Сначала добавь точку")
        return
    end

    State.Running = true
    State.RunToken += 1

    local token = State.RunToken

    SetStatus("Подготовка запуска...")

    if State.AutoMinimize then
        SetMinimized(true)
    end

    task.spawn(function()
        local success, err = pcall(function()
            if not WaitStartDelay(token) then
                return
            end

            if not CanContinue(token) then
                return
            end

            SetStatus("Автокликер работает")

            if State.RunMode == "TOGETHER" then
                RunTogether(token)
            else
                RunSequence(token)
            end
        end)

        if not success then
            warn("[AC v11] Engine error:", err)
        end

        if token == State.RunToken then
            State.Running = false
            SetStatus(
                success
                and "Цикл завершён"
                or "Ошибка движка"
            )

            UpdateMarkerList()
        end
    end)
end

-- ==========================================
-- 5. CONFIG SYSTEM
-- ==========================================

local function BuildConfig()
    local config = {
        Version = VERSION,

        Interval = State.Interval,
        HoldTime = State.HoldTime,
        StartDelay = State.StartDelay,

        ClickLimit = State.ClickLimit,

        OffsetX = State.OffsetX,
        OffsetY = State.OffsetY,

        MarkerSize = State.MarkerSize,

        RunMode = State.RunMode,
        ActionMode = State.ActionMode,

        Turbo = State.Turbo,
        Pulse = State.Pulse,
        AutoMinimize = State.AutoMinimize,

        Theme = State.Theme,

        Markers = {}
    }

    for _, marker in ipairs(State.Markers) do
        table.insert(config.Markers, {
            X = marker.X,
            Y = marker.Y,
            Enabled = marker.Enabled
        })
    end

    return config
end

local function ApplyConfig(config)
    if type(config) ~= "table" then
        return false
    end

    StopAutoClicker()

    State.Interval = math.clamp(
        tonumber(config.Interval) or 0.1,
        0.01,
        60
    )

    State.HoldTime = math.clamp(
        tonumber(config.HoldTime) or 0.015,
        0.005,
        5
    )

    State.StartDelay = math.clamp(
        tonumber(config.StartDelay) or 0,
        0,
        3600
    )

    State.ClickLimit = math.floor(math.clamp(
        tonumber(config.ClickLimit) or 0,
        0,
        1000000
    ))

    State.OffsetX = math.clamp(
        tonumber(config.OffsetX) or 35,
        -500,
        500
    )

    State.OffsetY = math.clamp(
        tonumber(config.OffsetY) or 105,
        -500,
        500
    )

    State.MarkerSize = math.floor(math.clamp(
        tonumber(config.MarkerSize) or 36,
        20,
        90
    ))

    State.RunMode =
        config.RunMode == "SEQUENCE"
        and "SEQUENCE"
        or "TOGETHER"

    State.ActionMode =
        config.ActionMode == "HOLD"
        and "HOLD"
        or "CLICK"

    State.Turbo = config.Turbo == true
    State.Pulse = config.Pulse ~= false
    State.AutoMinimize = config.AutoMinimize == true

    if Themes[config.Theme] then
        SetTheme(config.Theme)
    end

    for _, marker in ipairs(State.Markers) do
        if marker.Object then
            marker.Object:Destroy()
        end
    end

    table.clear(State.Markers)
    State.SelectedMarker = nil

    if type(config.Markers) == "table" then
        for _, data in ipairs(config.Markers) do
            if type(data) == "table" then
                local x = tonumber(data.X)
                local y = tonumber(data.Y)

                if x and y then
                    local marker = {
                        X = math.clamp(x, 0, 1),
                        Y = math.clamp(y, 0, 1),
                        Enabled = data.Enabled ~= false,
                        Color = Color3.fromRGB(60, 160, 255),
                        Object = nil
                    }

                    table.insert(State.Markers, marker)

                    local visual = New("TextButton", {
                        Size = UDim2.fromOffset(
                            State.MarkerSize,
                            State.MarkerSize
                        ),
                        Position = UDim2.new(
                            marker.X,
                            0,
                            marker.Y,
                            0
                        ),
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        BackgroundColor3 = marker.Color,
                        Text = tostring(#State.Markers),
                        TextColor3 = Color3.new(1, 1, 1),
                        TextSize = 12,
                        Font = Enum.Font.GothamBold,
                        Active = true,
                        ZIndex = 10
                    }, MarkerFolder)

                    Round(visual, 100)
                    Stroke(visual, Color3.new(1, 1, 1), 1.5)

                    marker.Object = visual
                end
            end
        end
    end

    State.SelectedMarker = State.Markers[1]

    SpeedInput.Text = tostring(State.Interval)
    HoldInput.Text = tostring(State.HoldTime)
    DelayInput.Text = tostring(State.StartDelay)
    LimitInput.Text = tostring(State.ClickLimit)

    MarkerSizeInput.Text = tostring(State.MarkerSize)
    OffsetXInput.Text = tostring(State.OffsetX)
    OffsetYInput.Text = tostring(State.OffsetY)

    ModeButton.Text =
        State.RunMode == "SEQUENCE"
        and "РЕЖИМ: ПО ОЧЕРЕДИ"
        or "РЕЖИМ: ВСЕ ТОЧКИ"

    ActionButton.Text =
        State.ActionMode == "HOLD"
        and "ДЕЙСТВИЕ: УДЕРЖАНИЕ"
        or "ДЕЙСТВИЕ: КЛИК"

    TurboButton.Text =
        "TURBO: " .. (State.Turbo and "ВКЛ" or "ВЫКЛ")

    PulseButton.Text =
        "ПУЛЬСАЦИЯ ТОЧЕК: " ..
        (State.Pulse and "ВКЛ" or "ВЫКЛ")

    AutoMinimizeButton.Text =
        "АВТОСКРЫТИЕ: " ..
        (State.AutoMinimize and "ВКЛ" or "ВЫКЛ")

    UpdateMarkerList()

    return true
end

