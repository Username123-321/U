local toggleFreeCam
toggleFreeCam = function(on)
    freeCamActive = on
    fcBtn.Text = on and "🎥 Free Camera: ВКЛ" or "🎥 Free Camera: ВЫКЛ"
    fcBtn.BackgroundColor3 = on and Color3.fromRGB(40,120,60) or Color3.fromRGB(30,30,40)
    tpCamBtn.Visible = on
    mobCtrl.Visible = on
    if on then
        savedCamCFrame = workspace.CurrentCamera.CFrame
        freeCamCFrame = workspace.CurrentCamera.CFrame
        workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
        camConn = RunService.RenderStepped:Connect(function(dt)
            local move = Vector3.new()
            if keys.W then move += freeCamCFrame.LookVector end
            if keys.S then move -= freeCamCFrame.LookVector end
            if keys.D then move += freeCamCFrame.RightVector end
            if keys.A then move -= freeCamCFrame.RightVector end
            if keys.Space then move += Vector3.new(0,1,0) end
            if keys.Shift then move -= Vector3.new(0,1,0) end
            if move.Magnitude > 0 then
                freeCamCFrame = freeCamCFrame + move.Unit * (freeCamSpeed * 30 * dt)
            end
            workspace.CurrentCamera.CFrame = freeCamCFrame
        end)
    else
        if camConn then camConn:Disconnect(); camConn = nil end
        if savedCamCFrame then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            workspace.CurrentCamera.CFrame = savedCamCFrame
        end
        savedCamCFrame = nil
    end
end

