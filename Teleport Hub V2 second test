local portalFolder = Instance.new("Folder")
portalFolder.Name = "TeleportHubPortals"
portalFolder.Parent = workspace

local portalModels = {}

local function buildPortalModel(name, pos, colorBg, colorTxt)
    local model = Instance.new("Model")
    model.Name = "Portal_"..name

    local ring = Instance.new("Part")
    ring.Name = "Ring"
    ring.Shape = Enum.PartType.Cylinder
    ring.Anchored = true
    ring.CanCollide = false
    ring.Material = Enum.Material.Neon
    ring.Color = colorBg or Color3.fromRGB(60,40,120)
    ring.Transparency = 0.2
    ring.Size = Vector3.new(1, 14, 14)
    ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
    ring.Parent = model

    local disc = Instance.new("Part")
    disc.Name = "Disc"
    disc.Shape = Enum.PartType.Cylinder
    disc.Anchored = true
    disc.CanCollide = false
    disc.Material = Enum.Material.ForceField
    disc.Color = colorBg or Color3.fromRGB(60,40,120)
    disc.Transparency = 0.5
    disc.Size = Vector3.new(0.4, 12, 12)
    disc.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
    disc.Parent = model

    local light = Instance.new("PointLight")
    light.Color = colorBg or Color3.fromRGB(60,40,120)
    light.Range = 16
    light.Brightness = 2
    light.Parent = ring

    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    pe.Color = ColorSequence.new(colorBg or Color3.fromRGB(60,40,120))
    pe.Size = NumberSequence.new(0.3)
    pe.Lifetime = NumberRange.new(0.8, 1.4)
    pe.Rate = 25
    pe.Speed = NumberRange.new(2, 4)
    pe.SpreadAngle = Vector2.new(180, 180)
    pe.Parent = ring

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 180, 0, 40)
    bill.StudsOffset = Vector3.new(0, 8, 0)
    bill.AlwaysOnTop = true
    bill.Parent = ring

    local bl = Instance.new("TextLabel")
    bl.Size = UDim2.new(1, 0, 1, 0)
    bl.BackgroundTransparency = 1
    bl.Text = name
    bl.TextColor3 = colorTxt or Color3.fromRGB(255,255,255)
    bl.TextScaled = true
    bl.TextStrokeTransparency = 0.3
    bl.Parent = bill

    model.PrimaryPart = ring
    model.Parent = portalFolder
    return model
end

local function updatePortalModel(p)
    if portalModels[p.Name] then portalModels[p.Name]:Destroy() end
    portalModels[p.Name] = buildPortalModel(p.Name, Vector3.new(unpack(p.Pos)), p.ColorBg, p.ColorTxt)
end

local function removePortalModel(name)
    if portalModels[name] then portalModels[name]:Destroy(); portalModels[name] = nil end
end

local function syncPortalModels()
    for name, m in pairs(portalModels) do
        local found = false
        for _, p in ipairs(portalsData) do
            if p.Name == name then found = true; break end
        end
        if not found then m:Destroy(); portalModels[name] = nil end
    end
    for _, p in ipairs(portalsData) do
        if not portalModels[p.Name] then updatePortalModel(p) end
    end
end

