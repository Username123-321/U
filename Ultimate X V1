-- Output function
local function Log(message, color)
    local Entry = Create("TextLabel", {
        Size = UDim2.new(1, -5, 0, 20),
        BackgroundTransparency = 1,
        Text = tostring(message),
        TextColor3 = color or Theme.Text,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y
    }, Output)

    Entry.LayoutOrder = #Output:GetChildren()

    local entries = {}
    for _, child in ipairs(Output:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(entries, child)
        end
    end

    while #entries > ConsoleState.MaxLines do
        entries[1]:Destroy()
        table.remove(entries, 1)
    end

    task.defer(function()
        Output.CanvasPosition = Vector2.new(
            0,
            math.max(0, OutputLayout.AbsoluteContentSize.Y)
        )
    end)
end

