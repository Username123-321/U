-- Command processor
local function ExecuteCommand(raw)
    local command = string.lower(
        string.match(raw, "^%s*(.-)%s*$") or ""
    )

    if command == "" then
        return
    end

    Log("> " .. command, Theme.Accent)

    table.insert(ConsoleState.History, command)
    ConsoleState.HistoryIndex = #ConsoleState.History

    local action = Commands[command]

    if not action then
        Error("Unknown command: " .. command)
        Info("Type 'help' for available commands.")
        return
    end

    local ok, result = pcall(action)

    if not ok then
        Error("Execution failed: " .. tostring(result))
    end
end

