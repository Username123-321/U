-- Refresh button
local function RefreshTelemetry()
    local character = Player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    local camera = workspace.CurrentCamera

    if not character or not humanoid or not root then
        Stats.Health.Text = "Unavailable"
        Stats.Position.Text = "--"
        Stats.Speed.Text = "--"
        Stats.Jump.Text = "--"
        Stats.State.Text = "No character"
        CharacterInfo.Text = "Waiting for character..."
        StatusDot.BackgroundColor3 =
            Color3.fromRGB(255, 105, 115)
        return
    end

    local hp = humanoid.Health
    local maxHp = humanoid.MaxHealth
    local position = root.Position

    Stats.Health.Text = string.format(
        "%.0f / %.0f HP", hp, maxHp
    )

    Stats.Position.Text = string.format(
        "%.1f, %.1f, %.1f",
        position.X,
        position.Y,
        position.Z
    )

    Stats.Speed.Text = string.format(
        "%.1f", humanoid.WalkSpeed
    )

    Stats.Jump.Text = string.format(
        "%.1f", humanoid.JumpPower
    )

    Stats.State.Text = tostring(
        humanoid:GetState()
    ):gsub("Enum.HumanoidStateType.", "")

    Stats.Camera.Text = camera
        and string.format("%.1f", camera.FieldOfView)
        or "Unavailable"

    local ratio = 0

    if maxHp > 0 then
        ratio = math.clamp(hp / maxHp, 0, 1)
    end

    HealthFill.Size = UDim2.new(ratio, 0, 1, 0)

    if ratio > 0.5 then
        HealthFill.BackgroundColor3 =
            Color3.fromRGB(100, 225, 150)
    elseif ratio > 0.25 then
        HealthFill.BackgroundColor3 =
            Color3.fromRGB(255, 190, 90)
    else
        HealthFill.BackgroundColor3 =
            Color3.fromRGB(255, 95, 105)
    end

    StatusDot.BackgroundColor3 =
        Color3.fromRGB(100, 225, 150)

    CharacterInfo.Text =
        "Name: " .. Player.Name ..
        "\nDisplay: " .. Player.DisplayName ..
        "\nCharacter: " .. character.Name
end

-- Manual refresh
local RefreshButton = AddButton(
    PlayerLab,
    "Refresh Statistics",
    "Immediately refresh all telemetry values.",
    function()
        RefreshTelemetry()
        Notify("Player Lab", "Statistics refreshed.")
    end
)

-- Monitoring loop
Lab.Connection = RunService.Heartbeat:Connect(function(dt)
    if not Lab.Enabled then
        return
    end

    Lab.LastUpdate = Lab.LastUpdate + dt

    if Lab.LastUpdate >= Lab.RefreshRate then
        Lab.LastUpdate = 0

        local success, err = pcall(RefreshTelemetry)

        if not success then
            warn("[Ultimate X] Telemetry error:", err)
        end
    end
end)

-- Respawn detection
Player.CharacterAdded:Connect(function(character)
    StatusDot.BackgroundColor3 =
        Color3.fromRGB(255, 190, 90)

    CharacterInfo.Text = "Character respawning..."

    task.wait(1)

    pcall(RefreshTelemetry)

    Notify("Player Lab", "New character detected.")
end)

-- Initial values
pcall(RefreshTelemetry)

print("[Ultimate X] Player Lab initialized.")
