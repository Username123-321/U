		vis.BoxGui = box
	elseif vis.BoxGui.Adornee ~= root then
		vis.BoxGui.Adornee = root
	end

	return vis
end

function Core.updateESP()
	local settings = Core.Settings
	local camera = Core.getCamera()

	if not settings.Enabled or not settings.ESPEnabled then
		Core.clearAllVisuals()
		return
	end

	local activePlayers: { [Player]: boolean } = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			continue
		end
		if settings.ESPTeamCheck and Core.isTeammate(player) then
			Core.removePlayerVisuals(player)
			continue
		end

		local character, humanoid, root = Core.getCharacterParts(player)
		if not character or not humanoid or not root then
			Core.removePlayerVisuals(player)
			continue
		end

		local distStuds = math.floor((root.Position - camera.CFrame.Position).Magnitude)
		if distStuds > settings.MaxDistance then
			Core.removePlayerVisuals(player)
			continue
		end

		activePlayers[player] = true
		local vis = ensurePlayerVisuals(player, character, root)
		local accent = Core.isTeammate(player) and Color3.fromRGB(56, 189, 248) or settings.ThemeAccent

		if vis.Highlight then
			vis.Highlight.Enabled = true
			vis.Highlight.FillColor = accent
			vis.Highlight.OutlineColor = Color3.new(1, 1, 1)
			vis.Highlight.FillTransparency = settings.ESPFillTransparency
			vis.Highlight.OutlineTransparency = settings.ESPOutlineTransparency
		end

		if vis.BoxGui then
			vis.BoxGui.Enabled = settings.ESPBoxes
			local frame = vis.BoxGui:FindFirstChild("BoxFrame")
			local stroke = frame and frame:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = accent
			end
		end

		if vis.Billboard then
			vis.Billboard.Enabled = settings.ESPNames or settings.ESPDistance or settings.ESPHealth
			if vis.NameLabel then
				vis.NameLabel.Visible = settings.ESPNames
				vis.NameLabel.Text = player.DisplayName
			end
			if vis.InfoLabel then
				vis.InfoLabel.Visible = settings.ESPDistance
				vis.InfoLabel.Text = string.format("[%d studs] • HP %d", distStuds, math.floor(humanoid.Health))
			end
			if vis.HealthBarFill and vis.HealthBarFill.Parent then
				local bg = vis.HealthBarFill.Parent :: Frame
				bg.Visible = settings.ESPHealth
				local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
				vis.HealthBarFill.Size = UDim2.fromScale(ratio, 1)
				vis.HealthBarFill.BackgroundColor3 = Color3.fromRGB(239, 68, 68):Lerp(Color3.fromRGB(52, 211, 153), ratio)
			end
		end

		if vis.TracerLine then
			pcall(function()
				local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
				if settings.ESPTracers and onScreen and screenPos.Z > 0 then
					vis.TracerLine.From = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y)
					vis.TracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
					vis.TracerLine.Color = accent
					vis.TracerLine.Visible = true
				else
					vis.TracerLine.Visible = false
				end
			end)
		end
	end

	for player in pairs(VisualsMap) do
		if not activePlayers[player] then
			Core.removePlayerVisuals(player)
		end
	end
end

Players.PlayerRemoving:Connect(Core.removePlayerVisuals)

return Core

