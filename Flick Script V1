	Enabled = true,
	AimEnabled = true,
	AimMode = "Flick",
	AimKey = Enum.UserInputType.MouseButton2,
	ToggleMenuKey = Enum.KeyCode.RightShift,
	TargetPart = "Head",
	FOVRadius = 155,
	ShowFOV = true,
	Smoothness = 0.22,
	FlickSnapSpeed = 0.75,
	AssistStrength = 0.35,
	Prediction = true,
	PredictionMultiplier = 0.135,
	WallCheck = true,
	TeamCheck = true,
	MaxDistance = 850,

	ESPEnabled = true,
	ESPBoxes = true,
	ESPTracers = false,
	ESPNames = true,
	ESPDistance = true,
	ESPHealth = true,
	ESPTeamCheck = true,
	ESPFillTransparency = 0.8,
	ESPOutlineTransparency = 0.15,

	MovementEnabled = false,
	WalkSpeed = 16,
	JumpPower = 50,
	InfiniteJump = false,
	Noclip = false,

	ThemeAccent = Color3.fromRGB(99, 102, 241),
