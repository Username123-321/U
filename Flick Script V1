local function addSlider(
	parent: Instance,
	text: string,
	minVal: number,
	maxVal: number,
	initial: number,
	decimals: number,
	onChanged: (number) -> ()
)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 50)
	row.BackgroundColor3 = Color3.fromRGB(23, 27, 37)
	row.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = row

	local title = Instance.new("TextLabel")
	title.Position = UDim2.fromOffset(12, 6)
	title.Size = UDim2.new(0.7, 0, 0, 18)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamMedium
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.fromRGB(220, 226, 240)
	title.Text = text
	title.Parent = row

	local fmt = "%." .. tostring(decimals) .. "f"
	local valLabel = Instance.new("TextLabel")
	valLabel.Position = UDim2.new(0.7, -12, 6, 0)
	valLabel.Size = UDim2.new(0.3, 0, 0, 18)
	valLabel.BackgroundTransparency = 1
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextSize = 12
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = Core.Settings.ThemeAccent
	valLabel.Text = string.format(fmt, initial)
	valLabel.Parent = row
	trackAccent(valLabel, "TextColor3")

	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.fromOffset(12, 31)
	barBg.Size = UDim2.new(1, -24, 0, 8)
	barBg.BackgroundColor3 = Color3.fromRGB(38, 43, 58)
	barBg.Parent = row

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = barBg

	local ratioInit = math.clamp((initial - minVal) / math.max(maxVal - minVal, 0.0001), 0, 1)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(ratioInit, 1)
	fill.BackgroundColor3 = Core.Settings.ThemeAccent
	fill.Parent = barBg

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill
	trackAccent(fill, "BackgroundColor3")

	local sliding = false
	local function setFromX(xPos: number)
		local rel = math.clamp((xPos - barBg.AbsolutePosition.X) / math.max(barBg.AbsoluteSize.X, 1), 0, 1)
		local raw = minVal + (maxVal - minVal) * rel
		local mult = 10 ^ decimals
		local rounded = math.floor(raw * mult + 0.5) / mult
		fill.Size = UDim2.fromScale(rel, 1)
		valLabel.Text = string.format(fmt, rounded)
		onChanged(rounded)
	end

	barBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
end

local function addCycleButton(parent: Instance, labelPrefix: string, options: { string }, initial: string, onChanged: (string) -> ())
	local idx = 1
	for i, opt in ipairs(options) do
		if opt == initial then
			idx = i
			break
		end
	end

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(25, 30, 42)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 12
	btn.TextColor3 = Color3.fromRGB(235, 238, 248)
	btn.Text = labelPrefix .. ": " .. options[idx]
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		idx = (idx % #options) + 1
		local chosen = options[idx]
		btn.Text = labelPrefix .. ": " .. chosen
		onChanged(chosen)
	end)
end

