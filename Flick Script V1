-- ЧАСТЬ 2: Контроллер наводки, круг FOV, стабилизация камеры и механики движения

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

export type AimController = {
	IsHoldingAim: boolean,
	FOVCircle: any,
	TargetDot: any,
	UpdateFOV: (core: any) -> (),
	UpdateAim: (core: any, dt: number) -> (),
	UpdateMovement: (core: any) -> (),
	ApplyNoclip: (core: any) -> (),
	ResetCharacterState: () -> (),
	CleanupDrawing: () -> (),
}

local AimAndMisc = {}

local function computeAimAlpha(settings: any, distRatio: number, dt: number): number
	local frameScale = math.clamp(dt * 60, 0.25, 2.5)
	if settings.AimMode == "Flick" then
		-- Быстрый доворот на дальних углах и более аккуратная фиксация вблизи центра
		local dynamicBoost = 0.75 + (1 - distRatio) * 0.35
		return math.clamp(settings.FlickSnapSpeed * dynamicBoost * frameScale, 0.08, 0.96)
	elseif settings.AimMode == "SilentAssist" then
		-- Лёгкая доводка без резкого рывка камеры
		return math.clamp(settings.AssistStrength * 0.45 * frameScale, 0.02, 0.45)
	else
		return math.clamp(settings.Smoothness * frameScale, 0.02, 0.85)
	end
end

local function createCircle(): any
	local circle: any = nil
	pcall(function()
		if Drawing then
			circle = Drawing.new("Circle")
			circle.Thickness = 1.6
			circle.NumSides = 72
			circle.Filled = false
			circle.Transparency = 0.85
			circle.Visible = false
		end
	end)
	return circle
end

local function createTargetMarker(): any
	local dot: any = nil
	pcall(function()
		if Drawing then
			dot = Drawing.new("Circle")
			dot.Thickness = 1.2
			dot.NumSides = 24
			dot.Radius = 5
			dot.Filled = true
			dot.Transparency = 0.8
			dot.Visible = false
		end
	end)
	return dot
end

function AimAndMisc.new(): AimController
	local controller: AimController = {
		IsHoldingAim = false,
		FOVCircle = createCircle(),
		TargetDot = createTargetMarker(),
		UpdateFOV = function() end,
		UpdateAim = function() end,
		UpdateMovement = function() end,
		ApplyNoclip = function() end,
		ResetCharacterState = function() end,
		CleanupDrawing = function() end,
	}

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			controller.IsHoldingAim = true
		elseif input.KeyCode == Enum.KeyCode.Space then
			local settingsRef = _G.FlickCoreSettings
			if not settingsRef or not settingsRef.Enabled or not settingsRef.MovementEnabled or not settingsRef.InfiniteJump then
				return
			end
			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
				local state = humanoid:GetState()
				if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
					root.AssemblyLinearVelocity = Vector3.new(
						root.AssemblyLinearVelocity.X,
						math.max(root.AssemblyLinearVelocity.Y, settingsRef.JumpPower),
						root.AssemblyLinearVelocity.Z
					)
				end
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			controller.IsHoldingAim = false
		end
	end)

	function controller.UpdateFOV(core: any)
		local settings = core.Settings
		local camera = core.getCamera()
		local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

		if controller.FOVCircle then
			pcall(function()
				controller.FOVCircle.Position = center
				controller.FOVCircle.Radius = settings.FOVRadius
				controller.FOVCircle.Color = settings.ThemeAccent
				controller.FOVCircle.Visible = settings.Enabled and settings.AimEnabled and settings.ShowFOV
			end)
		end

		if controller.TargetDot then
			pcall(function()
				local targetPart = core.getClosestTargetInFOV()
				if settings.Enabled and settings.AimEnabled and targetPart then
					local pos = core.getPredictedPosition(targetPart)
					local screenPos, onScreen = camera:WorldToViewportPoint(pos)
					if onScreen and screenPos.Z > 0 then
						controller.TargetDot.Position = Vector2.new(screenPos.X, screenPos.Y)
						controller.TargetDot.Color = settings.ThemeAccent
						controller.TargetDot.Visible = true
						return
					end
				end
				controller.TargetDot.Visible = false
			end)
		end
	end

	function controller.UpdateAim(core: any, dt: number)
		local settings = core.Settings
		if not settings.Enabled or not settings.AimEnabled then
			return
		end

		local holdingByKey = UserInputService:IsMouseButtonPressed(settings.AimKey) or controller.IsHoldingAim
		if not holdingByKey then
			return
		end

		local targetPart, _, screenDist = core.getClosestTargetInFOV()
		if not targetPart then
			return
		end

		local camera = core.getCamera()
		local predictedPos = core.getPredictedPosition(targetPart)
		local currentCF = camera.CFrame
		local targetCF = CFrame.lookAt(currentCF.Position, predictedPos)

		local distRatio = math.clamp((screenDist or settings.FOVRadius) / math.max(settings.FOVRadius, 1), 0, 1)
		local alpha = computeAimAlpha(settings, distRatio, dt)
		camera.CFrame = currentCF:Lerp(targetCF, alpha)
	end

	function controller.UpdateMovement(core: any)
		local settings = core.Settings
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end

		if settings.Enabled and settings.MovementEnabled then
			humanoid.WalkSpeed = settings.WalkSpeed
			humanoid.UseJumpPower = true
			humanoid.JumpPower = settings.JumpPower
		elseif humanoid.WalkSpeed ~= 16 then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
		end
	end

	function controller.ApplyNoclip(core: any)
		local settings = core.Settings
		local character = LocalPlayer.Character
		if not character then
			return
		end

		if settings.Enabled and settings.MovementEnabled and settings.Noclip then
			for _, obj in ipairs(character:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = false
				end
			end
		end
	end

	function controller.ResetCharacterState()
		local character = LocalPlayer.Character
		if not character then
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
		end
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = true
			end
		end
	end

	function controller.CleanupDrawing()
		pcall(function()
			if controller.FOVCircle then
				controller.FOVCircle:Remove()
			end
			if controller.TargetDot then
				controller.TargetDot:Remove()
			end
		end)
	end

	return controller
end

return AimAndMisc

