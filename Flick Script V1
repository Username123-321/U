	Enabled: boolean,
	AimEnabled: boolean,
	AimMode: AimMode,
	AimKey: Enum.UserInputType,
	ToggleMenuKey: Enum.KeyCode,
	TargetPart: TargetPartName,
	FOVRadius: number,
	ShowFOV: boolean,
	Smoothness: number,
	FlickSnapSpeed: number,
	AssistStrength: number,
	Prediction: boolean,
	PredictionMultiplier: number,
	WallCheck: boolean,
	TeamCheck: boolean,
	MaxDistance: number,

	ESPEnabled: boolean,
	ESPBoxes: boolean,
	ESPTracers: boolean,
	ESPNames: boolean,
	ESPDistance: boolean,
	ESPHealth: boolean,
	ESPTeamCheck: boolean,
	ESPFillTransparency: number,
	ESPOutlineTransparency: number,

	MovementEnabled: boolean,
	WalkSpeed: number,
	JumpPower: number,
	InfiniteJump: boolean,
	Noclip: boolean,

	ThemeAccent: Color3,
	UIScale: number,
}

