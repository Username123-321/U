type PlayerVisuals = {
	Highlight: Highlight?,
	Billboard: BillboardGui?,
	NameLabel: TextLabel?,
	InfoLabel: TextLabel?,
	HealthBarFill: Frame?,
	BoxGui: BillboardGui?,
	TracerLine: any,
}

local Core = {}
Core.Settings = table.clone(DefaultSettings)
Core.DefaultSettings = DefaultSettings

local VisualsMap: { [Player]: PlayerVisuals } = {}

local Presets: { [string]: { [string]: any } } = {
	Legit = {
		AimMode = "Smooth",
		FOVRadius = 110,
		Smoothness = 0.16,
		FlickSnapSpeed = 0.45,
		WallCheck = true,
		ESPTracers = false,
		ESPFillTransparency = 0.88,
	},
	FlickPro = {
		AimMode = "Flick",
		FOVRadius = 175,
		Smoothness = 0.28,
		FlickSnapSpeed = 0.85,
		Prediction = true,
		PredictionMultiplier = 0.14,
		WallCheck = true,
	},
	RageTest = {
		AimMode = "Flick",
		FOVRadius = 320,
		Smoothness = 0.65,
		FlickSnapSpeed = 1.0,
		WallCheck = false,
		ESPTracers = true,
		ESPFillTransparency = 0.65,
	},
}

function Core.applyPreset(presetName: string)
	local preset = Presets[presetName]
	if not preset then
		return
	end
	for key, val in pairs(preset) do
		(Core.Settings :: any)[key] = val
	end
end

function Core.getPresetNames(): { string }
	return { "Legit", "FlickPro", "RageTest" }
end

function Core.getCamera(): Camera
	local cam = workspace.CurrentCamera
	if not cam then
		cam = workspace:WaitForChild("Camera") :: Camera
	end
	return cam
end

function Core.isTeammate(player: Player): boolean
	if player == LocalPlayer then
		return true
	end
	if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
		return true
	end
	return false
end

function Core.getCharacterParts(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

function Core.getAimPart(character: Model, preferredName: TargetPartName): BasePart?
	local preferred = character:FindFirstChild(preferredName)
	if preferred and preferred:IsA("BasePart") then
		return preferred
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function Core.isVisible(fromPos: Vector3, targetPart: BasePart, targetCharacter: Model): boolean
	if not Core.Settings.WallCheck then
		return true
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filterList: { Instance } = {}
	if LocalPlayer.Character then
		table.insert(filterList, LocalPlayer.Character)
	end
	table.insert(filterList, targetCharacter)
	params.FilterDescendantsInstances = filterList
	params.IgnoreWater = true

	local direction = targetPart.Position - fromPos
	local result = workspace:Raycast(fromPos, direction, params)
	return result == nil
end

function Core.getPredictedPosition(part: BasePart): Vector3
	local pos = part.Position
	if not Core.Settings.Prediction then
		return pos
	end
	local velocity = part.AssemblyLinearVelocity
	return pos + (velocity * Core.Settings.PredictionMultiplier)
end

function Core.getClosestTargetInFOV(): (BasePart?, Model?, number?)
	local settings = Core.Settings
	if not settings.Enabled or not settings.AimEnabled then
		return nil, nil, nil
	end

	local camera = Core.getCamera()
	local viewportCenter = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

	local bestPart: BasePart? = nil
	local bestCharacter: Model? = nil
	local bestScreenDist = settings.FOVRadius

	for _, player in ipairs(Players:GetPlayers()) do
		if settings.TeamCheck and Core.isTeammate(player) then
			continue
		end

		local character, _, root = Core.getCharacterParts(player)
		if not character or not root then
			continue
		end

		local worldDist = (root.Position - camera.CFrame.Position).Magnitude
		if worldDist > settings.MaxDistance then
			continue
		end

		local aimPart = Core.getAimPart(character, settings.TargetPart)
		if not aimPart then
			continue
		end

		local predictedPos = Core.getPredictedPosition(aimPart)
		local screenPos, onScreen = camera:WorldToViewportPoint(predictedPos)
		if not onScreen or screenPos.Z <= 0 then
			continue
		end

		local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
		if screenDist <= bestScreenDist then
			if Core.isVisible(camera.CFrame.Position, aimPart, character) then
				bestScreenDist = screenDist
				bestPart = aimPart
				bestCharacter = character
			end
		end
	end

	return bestPart, bestCharacter, bestScreenDist
end

local function createTracer(): any
	local line: any = nil
	pcall(function()
		if Drawing then
			line = Drawing.new("Line")
			line.Thickness = 1.5
			line.Transparency = 0.85
			line.Visible = false
		end
	end)
	return line
end

function Core.removePlayerVisuals(player: Player)
	local vis = VisualsMap[player]
	if not vis then
		return
	end
	if vis.Highlight then
		vis.Highlight:Destroy()
	end
	if vis.Billboard then
		vis.Billboard:Destroy()
	end
	if vis.BoxGui then
		vis.BoxGui:Destroy()
	end
	if vis.TracerLine then
		pcall(function()
			vis.TracerLine:Remove()
		end)
	end
	VisualsMap[player] = nil
end

function Core.clearAllVisuals()
	for player in pairs(VisualsMap) do
		Core.removePlayerVisuals(player)
	end
end

local function ensurePlayerVisuals(player: Player, character: Model, root: BasePart): PlayerVisuals
